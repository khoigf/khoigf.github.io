# Từ @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# Chat ID nhóm (gõ /id trong nhóm sau khi thêm bot)
TELEGRAM_CHAT_ID=

# Múi giờ lịch gửi /ve
TZ=Asia/Ho_Chi_Minh

# URL public của server (Render tự có RENDER_EXTERNAL_URL; local thì để trống)
PUBLIC_URL=

# PAT GitHub Contents: Read and write — để sơ đồ không mất khi server restart
GITHUB_TOKEN=
GITHUB_REPO=khoigf/khoigf.github.io

# Chỉ khi muốn bot chụp trang khác, không phải chính server này
# VECOM_URL=https://khoigf.github.io/vecom/
